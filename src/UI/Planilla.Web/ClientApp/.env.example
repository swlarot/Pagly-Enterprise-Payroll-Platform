# API Base URL (build-time; usado por Vite)
# Development: http://localhost:5039 (o el puerto del API)
# Production: vacío si SPA y API van en el mismo dominio; si no, ej. https://planilla.tudominio.com
VITE_API_URL=

# Optional: entorno (development | production)
# VITE_APP_ENV=development

# Optional: Stripe (solo si habilitas pagos)
# VITE_STRIPE_PUBLIC_KEY=pk_live_...
# VITE_ENABLE_STRIPE=true
