# Configuración de desarrollo local
# Este archivo se usa automáticamente cuando ejecutas `npm run dev`

# URL del API backend (debe coincidir con launchSettings.json)
VITE_API_URL=http://localhost:5039

# Clave pública de Stripe (SOLO para testing, NO usar en producción)
# Obtén tu clave de prueba en: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLIC_KEY=

# Entorno actual
VITE_APP_ENV=development

# Feature flags (true/false)
VITE_ENABLE_STRIPE=false
VITE_ENABLE_ANALYTICS=false

# Configuración de API
VITE_API_TIMEOUT=30000
VITE_REFRESH_TOKEN_BUFFER=120000
