{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pagly",
  "version": "1.0.2",
  "identifier": "io.pagly.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../Planilla.Web/wwwroot"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pagly - Sistema de Planilla",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: https://app.pagly.clau.com.pa; connect-src 'self' https://app.pagly.clau.com.pa wss://app.pagly.clau.com.pa; img-src 'self' data: blob: https://app.pagly.clau.com.pa; style-src 'self' 'unsafe-inline'; script-src 'self' https://js.stripe.com; frame-src https://js.stripe.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
